; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Vespérine - Celui qui veille"
config/description="Jeu d'horreur à la première personne. Échappez au Veilleur du manoir Vespérine."
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.3", "GL Compatibility")
boot_splash/bg_color=Color(0, 0, 0, 1)
boot_splash/show_image=false
config/icon="res://icon.svg"
config/use_custom_user_dir=true
config/custom_user_dir_name="vesperine"

[audio]

driver/mix_rate=44100

[autoload]

Events="*res://scripts/autoload/events.gd"
Settings="*res://scripts/autoload/settings.gd"
GameManager="*res://scripts/autoload/game_manager.gd"
SaveSystem="*res://scripts/autoload/save_system.gd"
Assets="*res://scripts/autoload/assets.gd"
AudioManager="*res://scripts/autoload/audio_manager.gd"

[debug]

gdscript/warnings/untyped_declaration=1
gdscript/warnings/unsafe_property_access=0
gdscript/warnings/unsafe_method_access=0

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/vsync/vsync_mode=1

[layer_names]

3d_physics/layer_1="world"
3d_physics/layer_2="doors"
3d_physics/layer_3="player"
3d_physics/layer_4="monster"
3d_physics/layer_5="interact"
3d_physics/layer_7="nav_block"

[navigation]

3d/default_cell_size=0.2
3d/default_cell_height=0.1

[physics]

common/physics_ticks_per_second=60
common/max_physics_steps_per_frame=4

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
environment/defaults/default_clear_color=Color(0, 0, 0, 1)
lights_and_shadows/positional_shadow/atlas_size=2048
lights_and_shadows/positional_shadow/atlas_size.mobile=1024
anti_aliasing/quality/msaa_3d=0
limits/opengl/max_lights_per_object=16
occlusion_culling/use_occlusion_culling=true
textures/default_filters/anisotropic_filtering_level=1
